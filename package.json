{
  "name": "gorouter-v1",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode GoRouter V1 — localhost credential/lane router for OpenCode Go + Zen (account identity + service lane)",
  "scripts": {
    "start": "bun src/cli.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "desktop": "bun src/desktop/control-service.ts",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "test:wire-inspector": "bun test tools/wire-inspector",
    "build:wire-inspector": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-wire-inspector.ps1",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-dev.ps1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/bun": "^1.1.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
